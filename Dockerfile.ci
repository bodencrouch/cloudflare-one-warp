FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

LABEL org.opencontainers.image.source="https://github.com/bodencrouch/cloudflare-one-warp"
LABEL org.opencontainers.image.description="CI builder image for Cloudflare One WARP packaging"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  bash \
  ca-certificates \
  curl \
  file \
  flatpak \
  flatpak-builder \
  libfuse2 \
  rpm \
  shellcheck \
  sudo \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY package.json ./
COPY scripts/mock-warp-cli.sh ./scripts/mock-warp-cli.sh
RUN chmod +x ./scripts/mock-warp-cli.sh

CMD ["bash"]
