#!/usr/bin/env bash
set -euo pipefail

_script="${BASH_SOURCE[0]}"
while [[ -L "$_script" ]]; do
  _dir="$(cd -- "$(dirname -- "$_script")" && pwd)"
  _script="$(readlink "$_script")"
  [[ "$_script" != /* ]] && _script="$_dir/$_script"
done
APP_DIR="$(cd -- "$(dirname -- "$_script")/.." && pwd)"
unset _script _dir
APP_NAME="cloudflare-one-warp"
BASE_PORT=4173
PORT="$BASE_PORT"
HOST="127.0.0.1"
URL="http://${HOST}:${PORT}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cloudflare-one-warp"
RUNTIME_DIR="${XDG_RUNTIME_DIR:+${XDG_RUNTIME_DIR}/cloudflare-one-warp}"
RUNTIME_DIR="${RUNTIME_DIR:-${CACHE_DIR}/runtime}"
# Never follow a shared runtime-directory symlink or another user's directory.
if [[ -L "$RUNTIME_DIR" || ( -e "$RUNTIME_DIR" && ! -O "$RUNTIME_DIR" ) ]]; then
  echo "Unsafe runtime directory: $RUNTIME_DIR" >&2
  exit 1
fi
mkdir -p -m 700 "$RUNTIME_DIR"
chmod 700 "$RUNTIME_DIR"
PID_FILE="${RUNTIME_DIR}/server.pid"
PORT_FILE="${RUNTIME_DIR}/server.port"
LOG_FILE="${CACHE_DIR}/server.log"

mkdir -p "$RUNTIME_DIR" "$CACHE_DIR"

# Prefer a bundled Node (AppImage) when present.
if [[ -x "${APP_DIR}/runtime/node/bin/node" ]]; then
  NODE_BIN="${APP_DIR}/runtime/node/bin/node"
elif [[ -n "${CLOUDFLARE_ONE_WARP_NODE:-${CLOUDFLARE_ONE_GUI_NODE:-}}" ]]; then
  NODE_BIN="${CLOUDFLARE_ONE_WARP_NODE:-$CLOUDFLARE_ONE_GUI_NODE}"
else
  NODE_BIN="node"
fi

# Use the daemon's layered settings, including the saved port and XDG home.
LISTEN_CONFIG="$("$NODE_BIN" --input-type=module -e '
  import { pathToFileURL } from "node:url";
  const { loadConfig, isValidServerPort, effectiveBind } = await import(pathToFileURL(process.argv[1]));
  const config = loadConfig();
  const port = config.server.port;
  if (!isValidServerPort(port)) process.exit(1);
  console.log(`${port} ${effectiveBind(config)}`);
' "$APP_DIR/lib/config.mjs")"
BASE_PORT="${LISTEN_CONFIG%% *}"
HOST="${LISTEN_CONFIG#* }"
URL_HOST="$HOST"
[[ "$HOST" == *:* ]] && URL_HOST="[$HOST]"
PORT="$BASE_PORT"
URL="http://${URL_HOST}:${PORT}"

run_warp_cli() {
  local bin="${CLOUDFLARE_ONE_WARP_CLI:-${WARP_CLI:-warp-cli}}"
  if [[ -n "${FLATPAK_ID:-}" && "$bin" == "warp-cli" ]] && command -v flatpak-spawn >/dev/null 2>&1; then
    flatpak-spawn --host -- warp-cli "$@"
  else
    "$bin" "$@"
  fi
}

usage() {
  cat <<USAGE
Cloudflare One WARP — unofficial third-party Cloudflare One client

Usage:
  cloudflare-one-warp                    Start the selected desktop app (Cloudflare One Client by default)
  cloudflare-one-warp --no-open          Start/reuse the daemon (API-only by default)
  cloudflare-one-warp --daemon           Start/reuse the daemon with Web UI enabled
  cloudflare-one-warp --webui            Open the authenticated Web UI in a browser
  cloudflare-one-warp --status           Print daemon status
  cloudflare-one-warp --stop             Stop the managed daemon
  cloudflare-one-warp --warp-action       Connect or disconnect WARP via daemon API (no browser)
  cloudflare-one-warp --connect          Run warp-cli connect and open the Web UI
  cloudflare-one-warp --disconnect       Run warp-cli disconnect and open the Web UI
  cloudflare-one-warp --toggle           Connect if disconnected, otherwise disconnect (opens Web UI)
  cloudflare-one-warp --warp-status      Print warp-cli status
  cloudflare-one-warp --tray             Start the Cloudflare One WARP tray (PyQt6 native shell)
  cloudflare-one-warp --panel            Show the Cloudflare One WARP window (starts tray if needed)
  cloudflare-one-warp --version          Print Cloudflare One WARP version
  cloudflare-one-warp --help             Show this help

Aliases: cloudflare-one-warp, cloudflare-one-warp-gui (same binary)
Tray CLI: cloudflare-one-warp-tray
USAGE
}

is_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

health_ok() {
  "$NODE_BIN" "$APP_DIR/scripts/health-check.mjs" "$URL/api/health" >/dev/null 2>&1
}

webui_health_ok() {
  "$NODE_BIN" "$APP_DIR/scripts/health-webui-check.mjs" "$URL/api/health" --require-webui >/dev/null 2>&1
}

needs_webui() {
  [[ "${CLOUDFLARE_ONE_WARP_WEBUI:-0}" == "1" || "${CLOUDFLARE_ONE_WARP_WEBUI:-0}" == "true" ]]
}

daemon_ready() {
  "$NODE_BIN" "$APP_DIR/scripts/daemon-ready.mjs" "$URL/api/health" >/dev/null 2>&1
}

daemon_pid_matches_install() {
  local pid cmdline
  [[ -f "$PID_FILE" ]] || return 1
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ && "$pid" -gt 1 ]] || return 1
  if [[ -r "/proc/$pid/cmdline" ]]; then
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  else
    cmdline="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  fi
  [[ "$(ps -p "$pid" -o uid= 2>/dev/null | tr -d " ")" == "$UID" ]] || return 1
  [[ -n "$cmdline" && "$cmdline" == *"$APP_DIR/server.js"* ]]
}

restart_stale_daemon() {
  if is_running && daemon_pid_matches_install; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE" "$PORT_FILE"
  fi
}

set_port() {
  PORT="$1"
  URL="http://${URL_HOST}:${PORT}"
}

port_open() {
  "$NODE_BIN" "$APP_DIR/scripts/port-open.mjs" "$HOST" "$PORT" >/dev/null 2>&1
}

discover_port() {
  local candidate
  if is_running && [[ -f "$PORT_FILE" ]]; then
    candidate="$(cat "$PORT_FILE")"
    if [[ "$candidate" =~ ^[0-9]+$ ]] && (( candidate >= 1024 && candidate <= 65535 )); then
      set_port "$candidate"
      health_ok && return 0
    fi
  fi
  for candidate in $(seq "$BASE_PORT" "$((BASE_PORT + 30 > 65535 ? 65535 : BASE_PORT + 30))"); do
    set_port "$candidate"
    health_ok && return 0
  done
  set_port "$BASE_PORT"
  return 1
}

choose_port() {
  local candidate
  for candidate in $(seq "$BASE_PORT" "$((BASE_PORT + 30 > 65535 ? 65535 : BASE_PORT + 30))"); do
    set_port "$candidate"
    if health_ok; then
      return 0
    fi
    if ! port_open; then
      return 0
    fi
  done

  echo "No available local port found from $BASE_PORT to $((BASE_PORT + 30))." >&2
  return 1
}

start_server() {
  discover_port || choose_port

  if daemon_ready; then
    if ! needs_webui || webui_health_ok; then
      # systemd and directly launched daemons have no launcher PID file.
      return 0
    fi
    if is_running && daemon_pid_matches_install; then
      restart_stale_daemon
      # Shutdown releases the listening socket asynchronously.
      for _ in $(seq 1 80); do
        if ! port_open; then break; fi
        sleep 0.1
      done
    fi
  elif is_running && daemon_pid_matches_install; then
    restart_stale_daemon
  fi

  # Never replace an unmanaged daemon, including an older API revision or an
  # API-only system service. Find an unused port for this requested capability.
  local candidate found=0
  for candidate in $(seq "$BASE_PORT" "$((BASE_PORT + 30 > 65535 ? 65535 : BASE_PORT + 30))"); do
    set_port "$candidate"
    if ! port_open; then found=1; break; fi
  done
  if [[ "$found" != "1" ]]; then
    echo "No available local port found for the requested daemon capability." >&2
    return 1
  fi

  : > "$LOG_FILE"
  (
    cd "$APP_DIR"
    local server_env=(
      "PORT=$PORT"
      "CLOUDFLARE_ONE_WARP_PORT=$PORT"
      "CLOUDFLARE_ONE_WARP_WEBUI=${CLOUDFLARE_ONE_WARP_WEBUI:-0}"
    )
    if command -v setsid >/dev/null 2>&1; then
      nohup setsid env "${server_env[@]}" "$NODE_BIN" "$APP_DIR/server.js" >>"$LOG_FILE" 2>&1 &
    else
      nohup env "${server_env[@]}" "$NODE_BIN" "$APP_DIR/server.js" >>"$LOG_FILE" 2>&1 &
    fi
    echo "$!" > "$PID_FILE"
    printf '%s\n' "$PORT" > "$PORT_FILE"
  )

  for _ in $(seq 1 80); do
    if daemon_ready && { ! needs_webui || webui_health_ok; }; then
      return 0
    fi
    if ! is_running; then break; fi
    sleep 0.1
  done

  echo "Cloudflare One WARP daemon did not become healthy. Log: $LOG_FILE" >&2
  if is_running && daemon_pid_matches_install; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE" "$PORT_FILE"
  fi
  return 1
}

stop_server() {
  "$NODE_BIN" "$APP_DIR/scripts/webui-handoff.mjs" --cleanup >/dev/null 2>&1 || true
  if is_running && daemon_pid_matches_install; then
    kill "$(cat "$PID_FILE")"
    rm -f "$PID_FILE" "$PORT_FILE"
    echo "Stopped Cloudflare One WARP daemon."
  else
    echo "Cloudflare One WARP daemon is not running."
  fi
}

open_gui() {
  local handoff
  handoff="$("$NODE_BIN" "$APP_DIR/scripts/webui-handoff.mjs" "$URL")" || return 1
  case "$(uname -s)" in
    Darwin)
      if command -v open >/dev/null 2>&1; then
        open "$handoff"
        return
      fi
      ;;
    MINGW*|MSYS*|CYGWIN*)
      if command -v powershell.exe >/dev/null 2>&1; then
        # The URI is supplied as data, never interpolated into PowerShell code.
        CLOUDFLARE_ONE_WARP_HANDOFF="$handoff" powershell.exe -NoProfile -NonInteractive -Command 'Start-Process -FilePath $env:CLOUDFLARE_ONE_WARP_HANDOFF'
        return
      fi
      ;;
  esac
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$handoff"
  elif command -v firefox >/dev/null 2>&1; then
    firefox --new-window "$handoff" >/dev/null &
  else
    echo "No browser opener is available. Install a desktop browser and open Cloudflare One WARP again." >&2
    return 1
  fi
}

notify() {
  local title="$1"
  local body="$2"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$title" "$body" --icon="$APP_DIR/assets/cloudflare-one-warp.svg" >/dev/null 2>&1 || true
  fi
}

warp_status() {
  run_warp_cli --no-ansi --no-paginate status
}

run_warp_action() {
  local verb="$1"
  local output
  if output="$(run_warp_cli --no-ansi --no-paginate "$verb" 2>&1)"; then
    notify "Cloudflare One WARP" "warp-cli $verb completed"
    printf '%s\n' "$output"
  else
    notify "Cloudflare One WARP" "warp-cli $verb failed"
    printf '%s\n' "$output" >&2
    return 1
  fi
}

toggle_warp() {
  local status
  status="$(warp_status 2>&1 || true)"
  if printf '%s\n' "$status" | grep -qi 'Status update: Connected'; then
    run_warp_action disconnect
  else
    run_warp_action connect
  fi
}

case "${1:-}" in
  --help|-h)
    usage
    ;;
  --version|-V)
    "$NODE_BIN" --input-type=module -e "import { getVersion } from 'file://$APP_DIR/lib/version.mjs'; console.log(getVersion());"
    ;;
  --status)
    discover_port || true
    if daemon_ready; then
      echo "Cloudflare One WARP is running at $URL"
    else
      echo "Cloudflare One WARP is not running."
      exit 1
    fi
    ;;
  --stop)
    stop_server
    ;;
  --warp-action)
    start_server >/dev/null
    CLOUDFLARE_ONE_WARP_APP_DIR="$APP_DIR" exec python3 "$APP_DIR/scripts/tray-warp-action.py"
    ;;
  --connect)
    run_warp_action connect
    export CLOUDFLARE_ONE_WARP_WEBUI=1
    start_server
    open_gui
    ;;
  --disconnect)
    run_warp_action disconnect
    export CLOUDFLARE_ONE_WARP_WEBUI=1
    start_server
    open_gui
    ;;
  --toggle)
    toggle_warp
    export CLOUDFLARE_ONE_WARP_WEBUI=1
    start_server
    open_gui
    ;;
  --warp-status)
    warp_status
    ;;
  --tray)
    exec "$APP_DIR/bin/cloudflare-one-warp-tray" --force-cloudflare-one-warp
    ;;
  --panel)
    exec "$APP_DIR/bin/cloudflare-one-warp-tray" --panel
    ;;
  --no-open)
    start_server
    echo "$URL"
    ;;
  --webui)
    export CLOUDFLARE_ONE_WARP_WEBUI=1
    start_server
    open_gui
    ;;
  --daemon)
    export CLOUDFLARE_ONE_WARP_WEBUI=1
    start_server
    echo "$URL"
    ;;
  "")
    exec "$APP_DIR/bin/cloudflare-one-warp-tray"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
