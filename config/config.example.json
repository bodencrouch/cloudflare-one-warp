{
  "server": {
    "port": 4173,
    "bind": "127.0.0.1"
  },
  "webui": {
    "enabled": false,
    "allowRemote": false
  },
  "warp": {
    "cli": "warp-cli",
    "killSwitch": false,
    "killSwitchAllowLan": false
  },
  "ui": {
    "openBrowser": true,
    "theme": "system",
    "locale": "en",
    "notifications": true
  },
  "updates": {
    "channel": "stable",
    "source": {
      "owner": "bodencrouch",
      "repo": "cloudflare-one-warp"
    },
    "checkOnStartup": true
  },
  "tray": {
    "autostart": false,
    "shell": "cloudflare"
  }
}
