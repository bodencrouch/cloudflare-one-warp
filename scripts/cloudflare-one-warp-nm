#!/usr/bin/env bash
# Install Cloudflare One WARP NetworkManager profiles for KDE Plasma / NM integration.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"

INSTALL_DIR="${CLOUDFLARE_ONE_WARP_HOME:-$(cloudflare_one_warp_default_install_dir)}"
SCOPE="user"
RELOAD_NM=1

usage() {
  cat <<USAGE
Install Cloudflare WARP NetworkManager profiles (MASQUE, WireGuard, local proxy).

These appear in KDE System Settings → Network and the Plasma Networks widget.
These are addressless NetworkManager connections; select them from the connection list.
The system dispatcher starts and stops the official WARP client.

Usage:
  $(basename "$0") [options]

Options:
  --user          Install under XDG_CONFIG_HOME/NetworkManager (default)
  --system        Install dispatcher + sysctl via pkexec (requires admin)
  --install-dir   Cloudflare One WARP app root (default: local install dir)
  --no-reload     Skip nmcli reload
  -h, --help      Show help
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --user) SCOPE="user"; shift ;;
    --system) SCOPE="system"; shift ;;
    --install-dir) INSTALL_DIR="$2"; shift 2 ;;
    --no-reload) RELOAD_NM=0; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

cloudflare_one_warp_require_command node
if ! command -v nmcli >/dev/null 2>&1; then
  echo "NetworkManager (nmcli) is required for KDE/Plasma network integration." >&2
  exit 1
fi

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
[[ "$CONFIG_HOME" == /* ]] || CONFIG_HOME="${HOME}/.config"
NM_USER_DIR="${CONFIG_HOME}/NetworkManager/system-connections"
NM_SHARE_DIR="${INSTALL_DIR}/packaging/networkmanager/profiles"
DISPATCHER_SRC="${INSTALL_DIR}/packaging/networkmanager/99-cloudflare-one-warp"
DISPATCHER_DST="/etc/NetworkManager/dispatcher.d/99-cloudflare-one-warp"
SYSCTL_SRC="${INSTALL_DIR}/packaging/sysctl/99-cloudflare-one-warp.conf"
SYSCTL_DST="/etc/sysctl.d/99-cloudflare-one-warp.conf"

chmod +x "${INSTALL_DIR}/scripts/cloudflare-one-warp-connect" 2>/dev/null || true
chmod +x "${INSTALL_DIR}/scripts/cloudflare-one-warp-kde-proxy-sync" 2>/dev/null || true

echo "Generating NetworkManager profiles..."
mkdir -p "$NM_SHARE_DIR" "$NM_USER_DIR"
CLOUDFLARE_ONE_WARP_NM_SHARE="$NM_SHARE_DIR" CLOUDFLARE_ONE_WARP_NM_USER="$NM_USER_DIR" \
  node "${INSTALL_DIR}/scripts/sync-nm-profiles.mjs"

if [[ "$SCOPE" == "system" ]]; then
  if ! command -v pkexec >/dev/null 2>&1; then
    echo "pkexec required for --system install" >&2
    exit 1
  fi
  # Pass paths as positional arguments rather than interpolating privileged shell code.
  pkexec /bin/bash -c '
    set -euo pipefail
    install -D -m 0755 "$1" /usr/local/bin/cloudflare-one-warp-connect
    install -D -m 0755 "$2" /etc/NetworkManager/dispatcher.d/99-cloudflare-one-warp
    install -D -m 0644 "$3" /etc/sysctl.d/99-cloudflare-one-warp.conf
    # Remove the legacy descriptor: no custom NetworkManager VPN plugin exists.
    rm -f /usr/lib/NetworkManager/VPN/nm-cloudflare-one-warp-service.name
    sysctl -p /etc/sysctl.d/99-cloudflare-one-warp.conf
  ' cloudflare-one-warp-install \
    "${INSTALL_DIR}/scripts/cloudflare-one-warp-connect" "$DISPATCHER_SRC" "$SYSCTL_SRC"

else
  echo "Tip: run $(basename "$0") --system once (with pkexec) so KDE connect/disconnect hooks work system-wide."
fi

if [[ "$RELOAD_NM" -eq 1 ]]; then
  for profile in "${NM_USER_DIR}/Cloudflare One WARP-WARP-"*.nmconnection; do
    [[ -f "$profile" ]] || continue
    nmcli connection load "$profile"
  done
  nmcli connection reload
fi

echo "Cloudflare One WARP network profiles ready."
echo "  Select the addressless Cloudflare One WARP connection in NetworkManager."
echo "  Or pick: Cloudflare One WARP (MASQUE | WireGuard | Local proxy) in the connection list."
echo "  Docs: ${INSTALL_DIR}/docs/NETWORKING.md"
