#!/usr/bin/env bash
# Apply Cloudflare WARP settings for a Cloudflare One WARP NetworkManager VPN profile.
set -euo pipefail

usage() {
  cat <<USAGE
Usage:
  cloudflare-one-warp-connect up   <connection-id>
  cloudflare-one-warp-connect down <connection-id>
USAGE
}

require_warp() {
  if ! command -v warp-cli >/dev/null 2>&1; then
    echo "cloudflare-one-warp-connect: warp-cli not found" >&2
    exit 1
  fi
}

APP_ROOT="${CLOUDFLARE_ONE_WARP_HOME:-}"
if [[ -z "$APP_ROOT" ]]; then
  if [[ -d "${HOME}/.local/share/cloudflare-one-warp" ]]; then
    APP_ROOT="${HOME}/.local/share/cloudflare-one-warp"
  elif [[ -d /usr/lib/cloudflare-one-warp ]]; then
    APP_ROOT="/usr/lib/cloudflare-one-warp"
  fi
fi

KDE_PROXY="${APP_ROOT}/scripts/cloudflare-one-warp-kde-proxy-sync"

warp_up() {
  local connection_id="$1"
  require_warp

  case "$connection_id" in
    "Cloudflare One WARP (MASQUE)")
      warp-cli tunnel protocol set MASQUE
      warp-cli mode warp
      warp-cli connect
      ;;
    "Cloudflare One WARP (WireGuard)")
      warp-cli tunnel protocol set WireGuard
      warp-cli mode warp
      warp-cli connect
      ;;
    "Cloudflare One WARP (Local proxy)")
      warp-cli tunnel protocol set MASQUE
      warp-cli mode proxy
      warp-cli proxy port "${CLOUDFLARE_ONE_WARP_PROXY_PORT:-40000}"
      warp-cli connect
      if [[ -x "$KDE_PROXY" ]]; then
        "$KDE_PROXY" on "${CLOUDFLARE_ONE_WARP_PROXY_PORT:-40000}" || true
      fi
      ;;
    *)
      echo "cloudflare-one-warp-connect: unknown profile ${connection_id}" >&2
      exit 1
      ;;
  esac
}

warp_down() {
  require_warp
  warp-cli disconnect || true
  if [[ -x "$KDE_PROXY" ]]; then
    "$KDE_PROXY" off || true
  fi
}

ACTION="${1:-}"
CONNECTION_ID="${2:-}"

case "$ACTION" in
  up)
    [[ -n "$CONNECTION_ID" ]] || { usage >&2; exit 2; }
    warp_up "$CONNECTION_ID"
    ;;
  down)
    warp_down
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
