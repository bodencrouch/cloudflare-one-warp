                    },
                    "webuiEnabled": {
                      "type": "boolean"
                    },
                    "effectivePort": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      },
      "head": {
        "summary": "Public metadata probe without a response body",
        "security": [],
        "responses": {
          "200": {
            "description": "The daemon is listening; no response body."
          }
        }
      }
    },
