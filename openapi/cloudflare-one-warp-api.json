{
  "openapi": "3.0.3",
  "info": {
    "title": "Cloudflare One WARP local API",
    "version": "0.2.8",
    "description": "Control-plane contract for the Node daemon. Validated in Plane M CI against a mock warp-cli.\n\nRequests that change anything (POST/PUT/PATCH/DELETE) must come from this computer, be addressed to a loopback Host, send `Content-Type: application/json`, and carry the local session credential in `X-Cloudflare-One-Warp-Session`. Fetch the credential from `GET /api/session` or read it from `~/.config/cloudflare-one-warp/session-<port>.token`."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4173"
    }
  ],
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Cloudflare-One-Warp-Session",
        "description": "Owner-readable private-file credential required for every private API read, stream and mutation. Launch the browser with cloudflare-one-warp --webui; credentials never appear in HTTP URLs."
      }
    },
    "responses": {
      "Blocked": {
        "description": "Request refused by the local request gate (foreign Host or Origin, remote peer, or missing session credential).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "ok",
                "error",
                "reason"
              ],
              "properties": {
                "ok": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                "error": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "host_not_allowed",
                    "remote_peer_denied",
                    "cross_site_denied",
                    "cross_origin_denied",
                    "json_required",
                    "session_required"
                  ]
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid owner credential. Reopen the client to authorize this browser or reload the private token file.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "ok",
                "error",
                "reason"
              ],
              "properties": {
                "ok": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                "error": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "session_required"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/session": {
      "get": {
        "summary": "Session credential for local clients",
        "description": "Returns the current credential only after the same owner credential is supplied in the header. This endpoint cannot bootstrap an unauthenticated client.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "session",
                    "header"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "session": {
                      "type": "string"
                    },
                    "header": {
                      "type": "string",
                      "enum": [
                        "x-cloudflare-one-warp-session"
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Blocked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
