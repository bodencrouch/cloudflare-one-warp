                    "app",
                    "version"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "app": {
                      "type": "string",
                      "enum": [
                        "thirdflare"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "webuiEnabled": {
                      "type": "boolean"
                    },
                    "effectivePort": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
