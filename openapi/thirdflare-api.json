                    "hardBlocked",
                    "items",
                    "killSwitchMode"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "hardBlocked": {
                      "type": "boolean"
                    },
                    "softWarnings": {
                      "type": "boolean"
                    },
                    "needsAttention": {
                      "type": "boolean"
                    },
                    "killSwitchMode": {
                      "type": "string",
                      "enum": [
                        "off",
                        "always_on",
                        "paused"
                      ]
                    },
                    "connectBlockedBy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "generatedAt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
