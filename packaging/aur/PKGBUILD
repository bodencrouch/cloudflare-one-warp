# Maintainer: Cloudflare One WARP contributors
pkgname=cloudflare-one-warp
pkgver=0.3.6
pkgrel=1
pkgdesc="Cloudflare One WARP — unofficial Cloudflare One client via warp-cli"
arch=('any')
url="https://github.com/bodencrouch/cloudflare-one-warp"
license=('MIT')
depends=('nodejs>=22')
optdepends=(
  'python-pyqt6: KDE/Wayland native tray shell with embedded Web UI'
  'python-pyqt6-webengine: embedded Web UI for PyQt6 tray'
  'yad: optional notification-area tray menu fallback'
  'libnotify: desktop notifications'
  'cloudflare-warp-bin: Cloudflare WARP client providing warp-cli (AUR)'
)
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/bodencrouch/cloudflare-one-warp/releases/download/v${pkgver}/cloudflare-one-warp-${pkgver}-src.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}"
  PAYLOAD_DIR="${pkgdir}" PACKAGE_VERSION="${pkgver}" bash packaging/scripts/stage-payload.sh
}
