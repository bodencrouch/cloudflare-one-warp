<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Cloudflare One WARP</vendor>
  <vendor_url>https://github.com/bodencrouch/cloudflare-one-warp</vendor_url>

  <action id="com.cloudflare.one.warp.nft-apply">
    <description>Apply Cloudflare One WARP kill switch nftables rules</description>
    <message>Authentication is required to update the Cloudflare One WARP kill switch</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/cloudflare-one-warp/scripts/cloudflare-one-warp-nft-apply</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
